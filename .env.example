# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# `.env.local` is the single source of local secrets for both Next.js and the
# Cloudflare platform proxy. Do NOT create `.dev.vars` (it shadows `.env.local`).
# `.env.local` is gitignored - never commit real values.
#
# The committed `.env` is SOPS-encrypted for maintainers; contributors cannot
# decrypt it and should not need to.
#
# Names below are taken from the code. Sections marked "optional" fall back to
# a default or disable only that feature when unset.

# --- Auth (required to sign in locally) --------------------------------------
# OAuth client registered with Elixpo Accounts (https://accounts.elixpo.com).
NEXT_PUBLIC_ELIXPO_CLIENT_ID=
ELIXPO_CLIENT_SECRET=
# Signs the session cookie (HMAC). Any long random string works locally,
# e.g. `openssl rand -hex 32`. Login fails without it.
SESSION_SECRET=

# --- Public API / CLI bearer auth (optional) ---------------------------------
# PEM public key used to verify Elixpo Accounts JWTs on /api/v1/*.
ACCOUNTS_JWT_PUBLIC_KEY=
# Defaults: blogs.elixpo.com / lixblogs-cli-prod
LIXBLOGS_API_AUDIENCE=
LIXBLOGS_CLI_CLIENT_IDS=

# --- Realtime collaboration (optional) ---------------------------------------
# Defaults to the hosted collab worker. Point at your own `worker/collab`
# deployment to test collaboration changes.
NEXT_PUBLIC_COLLAB_URL=

# --- Media uploads: creator-owned Cloudinary (optional) ----------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_OAUTH_CLIENT_ID=
CLOUDINARY_OAUTH_CLIENT_SECRET=
# Encrypts stored creator connections.
CLOUDINARY_CONNECTION_ENCRYPTION_KEY=

# --- AI writing and image integrations (optional) ----------------------------
ELIXPO_SEARCH_API_KEY=
# Set the feature flag to `true` to enable the Pollinations image connector.
# The app key must start with `pk_`.
POLLINATIONS_IMAGE_CONNECTOR_ENABLED=false
POLLINATIONS_APP_KEY=
POLLINATIONS_CONNECTION_ENCRYPTION_KEY=

# --- Email (optional) --------------------------------------------------------
# Defaults: smtp.gmail.com / 465 / "LixBlogs"
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME=
# Set to `true` to enable the weekly digest cron route.
ENABLE_WEEKLY_DIGEST=

# --- Cron / background jobs (optional) ---------------------------------------
CRON_SECRET=
# Base URL used by `worker/cron` (defaults to https://blogs.elixpo.com).
APP_URL=

# --- Billing / payouts (optional) --------------------------------------------
ELIXPO_PAY_API_KEY=
ELIXPO_PAY_ID=
ELIXPO_PAY_WEBHOOK_SECRET=
ACCOUNTS_WEBHOOK_SECRET=
ACCOUNTS_APP_WEBHOOK_SECRET=
# Override to use a dev payouts instance (default https://payouts.elixpo.com).
PAYOUTS_URL=

# --- Moderation / GitHub integration (optional) ------------------------------
MODERATION_SECRET=
# Defaults to elixpo/lixblogs
MODERATION_REPO=
GITHUB_ACCESS_TOKEN=

# --- Misc integrations (optional) --------------------------------------------
# Link shortener (defaults to https://lixrl.com).
LIXRL_URL=
LIXRL_SHORTNER_TOKEN=
# Defaults to https://sketch.elixpo.com
NEXT_PUBLIC_LIXSKETCH_EMBED_URL=

# Deploy/release-only secrets (CLOUDFLARE_API_TOKEN, NPM_TOKEN, VSCE_PAT, ...)
# are managed by maintainers in CI and are intentionally not listed here.
