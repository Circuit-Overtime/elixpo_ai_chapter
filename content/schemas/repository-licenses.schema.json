{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/repository-licenses.schema.json",
  "title": "Elixpo repository license evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "statusOwner", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "statusOwner": { "type": "string", "minLength": 2 },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detection", "classification", "spdxId", "evidenceUrl", "summary", "verifiedAt"],
        "properties": {
          "detection": { "enum": ["MIT", "Apache-2.0", "CC0-1.0", "NOASSERTION", "MISSING"] },
          "classification": { "enum": ["spdx-recognized", "external-spdx", "custom-mixed", "missing"] },
          "spdxId": { "type": ["string", "null"] },
          "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
          "summary": { "type": "string", "minLength": 40, "maxLength": 360 },
          "verifiedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
