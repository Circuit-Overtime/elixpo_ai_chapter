{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/discussions.schema.json",
  "title": "Elixpo public discussion source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "statusOwner", "sourceRepository", "organizationUrl", "apiUrl", "status", "eligibleCategories", "featuredDiscussionNumbers", "refreshSeconds", "responsePolicy", "moderation"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "statusOwner": { "type": "string", "minLength": 1 },
    "sourceRepository": { "type": "string", "format": "uri" },
    "organizationUrl": { "type": "string", "format": "uri" },
    "apiUrl": { "type": "string", "format": "uri" },
    "status": { "enum": ["active", "paused", "disabled"] },
    "eligibleCategories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "featuredDiscussionNumbers": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "refreshSeconds": { "type": "integer", "minimum": 300 },
    "responsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceAndProjectOwner", "researchOwner", "chapterOwner", "unansweredReviewDays", "commitment", "escalationUrl"],
      "properties": {
        "serviceAndProjectOwner": { "type": "string", "minLength": 20 },
        "researchOwner": { "type": "string", "minLength": 20 },
        "chapterOwner": { "type": "string", "minLength": 20 },
        "unansweredReviewDays": { "type": "integer", "minimum": 1 },
        "commitment": { "enum": ["best-effort-public-review"] },
        "escalationUrl": { "type": "string", "format": "uri" }
      }
    },
    "moderation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludeLocked", "excludedDiscussionNumbers", "excludedAuthors", "featuredRequiresEditorialSelection", "fallbackMessage"],
      "properties": {
        "excludeLocked": { "type": "boolean" },
        "excludedDiscussionNumbers": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "excludedAuthors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "featuredRequiresEditorialSelection": { "const": true },
        "fallbackMessage": { "type": "string", "minLength": 40 }
      }
    }
  }
}
