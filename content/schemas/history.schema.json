{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/history.schema.json",
  "title": "Elixpo institutional history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "methodology", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "methodology": { "type": "string", "minLength": 80 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "datePrecision", "title", "description", "kind", "evidence"],
        "properties": {
          "period": { "type": "string", "minLength": 4 },
          "datePrecision": { "enum": ["verified-day", "verified-month", "verified-year", "verified-range", "approximate"] },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 50 },
          "kind": { "enum": ["origin", "growth", "systems", "direction", "release", "research", "stewardship", "archive"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string", "minLength": 3 }, "url": { "type": "string", "format": "uri" } } } }
        }
      }
    }
  }
}
