{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/contributors.schema.json",
  "title": "Elixpo evidence-led contributor recognition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "methodology", "recordPolicy", "selectionPolicy", "excludedLeadHandles", "excludedAutomationHandles", "featured"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "methodology": { "type": "string", "minLength": 40 },
    "recordPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "verificationRule", "correctionRule", "fraudRule", "withdrawalRule"],
      "properties": {
        "recordType": { "const": "public-evidence-record" },
        "verificationRule": { "type": "string", "minLength": 60 },
        "correctionRule": { "type": "string", "minLength": 60 },
        "fraudRule": { "type": "string", "minLength": 60 },
        "withdrawalRule": { "type": "string", "minLength": 60 }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "sourceRepository", "eligibleContributorCount", "minimumCoveragePercent", "minimumFeaturedCount", "minimumObservedContributions", "reviewCadence", "correctionUrl", "optOutUrl"],
      "properties": {
        "basis": { "type": "string", "minLength": 40 },
        "sourceRepository": { "type": "string", "format": "uri" },
        "eligibleContributorCount": { "type": "integer", "minimum": 1 },
        "minimumCoveragePercent": { "type": "number", "minimum": 1, "maximum": 100 },
        "minimumFeaturedCount": { "type": "integer", "minimum": 1 },
        "minimumObservedContributions": { "type": "integer", "minimum": 1 },
        "reviewCadence": { "type": "string", "minLength": 20 },
        "correctionUrl": { "type": "string", "format": "uri" },
        "optOutUrl": { "type": "string", "format": "uri" }
      }
    },
    "excludedLeadHandles": { "$ref": "#/$defs/handles" },
    "excludedAutomationHandles": { "$ref": "#/$defs/handles" },
    "featured": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "handle", "name", "observedContributions", "activeWindow", "story", "github", "portfolio", "profileSource", "workRecords", "evidence"],
        "properties": {
          "recordId": { "type": "string", "pattern": "^ECR-[0-9]{4}-[0-9]{3}$" },
          "handle": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "observedContributions": { "type": "integer", "minimum": 1 },
          "activeWindow": { "type": "string", "minLength": 4 },
          "story": { "type": "string", "minLength": 40 },
          "github": { "type": "string", "format": "uri" },
          "portfolio": { "type": ["string", "null"], "format": "uri" },
          "profileSource": { "enum": ["public-evidence-only", "consented"] },
          "workRecords": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workRecord" } },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
        }
      }
    }
  },
  "$defs": {
    "handles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "workRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "projectIds", "role", "dateRange", "outcome", "demonstratedSkills", "evidenceIndexes", "reviewAttribution"],
      "properties": {
        "label": { "type": "string", "minLength": 5 },
        "projectIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "role": { "type": "string", "minLength": 5 },
        "dateRange": { "type": "string", "minLength": 4 },
        "outcome": { "type": "string", "minLength": 40 },
        "demonstratedSkills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "evidenceIndexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "reviewAttribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "statement"],
          "properties": {
            "status": { "enum": ["named-reviewer", "repository-review-record", "not-publicly-attributed"] },
            "reviewer": { "type": ["string", "null"] },
            "statement": { "type": "string", "minLength": 30 }
          },
          "allOf": [{
            "if": { "properties": { "status": { "const": "named-reviewer" } } },
            "then": { "properties": { "reviewer": { "type": "string", "minLength": 1 } } }
          }]
        }
      }
    }
  }
}
