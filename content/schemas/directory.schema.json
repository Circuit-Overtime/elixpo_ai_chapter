{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/directory.schema.json",
  "title": "Elixpo public directory editorial records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "statusOwner", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "statusOwner": { "type": "string", "minLength": 2 },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "summary", "description", "focus"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "website": { "type": "string", "format": "uri" },
          "icon": { "type": "string", "pattern": "^/" },
          "summary": { "type": "string", "minLength": 20, "maxLength": 180 },
          "description": { "type": "string", "minLength": 60, "maxLength": 600 },
          "focus": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "featured": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string", "minLength": 3 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
