{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/licensing.schema.json",
  "title": "Elixpo licensing direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lastVerified",
    "statusOwner",
    "policyStatus",
    "currentRepositoryRule",
    "defaultsForNewWork",
    "memberProjects",
    "existingRepositories",
    "trademarks",
    "openSourceClaims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "lastVerified": {"type": "string", "format": "date"},
    "statusOwner": {"type": "string", "minLength": 2},
    "policyStatus": {"enum": ["draft", "approved-direction", "published"]},
    "currentRepositoryRule": {"type": "string", "minLength": 20},
    "defaultsForNewWork": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactClass", "default", "alternatives", "selectionRule"],
        "properties": {
          "artifactClass": {
            "enum": [
              "source-code",
              "papers-and-documentation",
              "hardware-source",
              "datasets",
              "models-and-weights",
              "brand-assets-and-stickers"
            ]
          },
          "default": {"type": ["string", "null"]},
          "alternatives": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "selectionRule": {"type": "string", "minLength": 20}
        }
      }
    },
    "memberProjects": {"$ref": "#/$defs/ruleStatement"},
    "existingRepositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationRule", "unclearLicenseRule", "statement"],
      "properties": {
        "migrationRule": {"const": "rights-and-contributor-audit-required"},
        "unclearLicenseRule": {"const": "preserve-without-reuse-claim"},
        "statement": {"type": "string", "minLength": 20}
      }
    },
    "trademarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separateFromCopyright", "policyStatus", "policyUrl", "statement", "referentialUse", "permissionRequired", "prohibitedUse"],
      "properties": {
        "separateFromCopyright": {"const": true},
        "policyStatus": {"enum": ["pending", "published"]},
        "policyUrl": {"type": "string", "format": "uri"},
        "statement": {"type": "string", "minLength": 20},
        "referentialUse": {"type": "string", "minLength": 40},
        "permissionRequired": {"type": "string", "minLength": 40},
        "prohibitedUse": {"type": "string", "minLength": 40}
      }
    },
    "openSourceClaims": {"$ref": "#/$defs/ruleStatement"}
  },
  "$defs": {
    "ruleStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "statement"],
      "properties": {
        "rule": {"type": "string", "minLength": 2},
        "statement": {"type": "string", "minLength": 20}
      }
    }
  }
}
