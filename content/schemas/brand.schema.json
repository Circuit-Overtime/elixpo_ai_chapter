{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/brand.schema.json",
  "title": "Elixpo canonical brand record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "canonicalHome", "sourceRepository", "migrationStatus", "visualDirection", "assetGroups", "note"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "canonicalHome": { "type": "string", "format": "uri" },
    "sourceRepository": { "type": "string", "format": "uri" },
    "migrationStatus": { "enum": ["not-started", "in-progress", "portal-canonical-assets-migrated", "complete"] },
    "visualDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "principle", "palette"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "principle": { "type": "string", "minLength": 30 },
        "palette": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hex"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        }
      }
    },
    "assetGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "path": { "type": "string", "pattern": "^/" },
          "status": { "enum": ["staged", "canonical", "retired"] }
        }
      }
    },
    "note": { "type": "string", "minLength": 40 }
  }
}
