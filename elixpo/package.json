{
  "name": "elixpo",
  "version": "2.1.2",
  "description": "The public portal for Elixpo, an open-source project foundry for software, research, and operated services.",
  "author": {
    "name": "Ayushman Bhattacharya",
    "url": "https://github.com/Circuit-Overtime"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://elixpo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/elixpo/elixpo"
  },
  "keywords": [
    "elixpo",
    "open-source",
    "project-foundry",
    "open-research",
    "developer-tools",
    "next.js",
    "community"
  ],
  "private": true,
  "scripts": {
    "dev": "NEXT_PRIVATE_NO_CACHE=1 next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "registry:check": "node scripts/validate-registry.mjs",
    "registry:links": "node scripts/check-registry-links.mjs",
    "repository:check": "python3 scripts/check-repository-conformance.py",
    "repository:migrate": "python3 scripts/prepare-repository-migrations.py",
    "audit:public": "python3 scripts/audit-public-surfaces.py --json audit/public-surfaces.json --markdown audit/public-surfaces.md",
    "workflow:deploy:check": "python3 scripts/check-deployment-workflow.py",
    "readme:check": "node scripts/render-readmes.mjs --check",
    "readme:write": "node scripts/render-readmes.mjs --write",
    "readme:sync-workspace": "node scripts/render-readmes.mjs --sync-workspace"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.0",
    "motion": "^12.40.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
