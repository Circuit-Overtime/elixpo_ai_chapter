{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/repositories.schema.json",
  "title": "Elixpo repository inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotDate",
    "statusOwner",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotDate": {
      "type": "string",
      "format": "date"
    },
    "statusOwner": {
      "type": "string",
      "minLength": 2
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repositoryUrl",
          "disposition",
          "publicClass",
          "relationship",
          "lifecycle",
          "custody",
          "githubArchived",
          "verificationState",
          "statusVerifiedAt",
          "statusOwner"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repositoryUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "disposition": {
            "enum": [
              "public-entry",
              "supporting-repository",
              "duplicate-or-redirect",
              "exclude"
            ]
          },
          "publicClass": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "project",
              "research",
              "service",
              null
            ]
          },
          "relationship": {
            "enum": [
              "core",
              "chapter",
              "member",
              "connected"
            ]
          },
          "lifecycle": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "incubating",
              "active",
              "maintenance",
              "paused",
              "completed",
              "archived",
              null
            ]
          },
          "custody": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "elixpo-owned",
              "transferred-to-elixpo",
              "externally-owned",
              "mirrored",
              null
            ]
          },
          "githubArchived": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "verificationState": {
            "enum": [
              "verified",
              "decision-recorded",
              "needs-decision"
            ]
          },
          "statusVerifiedAt": {
            "type": "string",
            "format": "date"
          },
          "statusOwner": {
            "type": "string",
            "minLength": 2
          },
          "pendingDecisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          },
          "canonicalRepository": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string",
            "format": "date"
          },
          "githubRepositoryId": {
            "type": "integer"
          },
          "finalCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "researchStatus": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string"
          },
          "governance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "originalMaintainerRetainsAdmin": {
                "type": "boolean"
              },
              "originalMaintainerRetainsProjectAuthority": {
                "type": "boolean"
              }
            }
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "versionObserved",
              "deprecationApproved",
              "deprecationApplied"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "versionObserved": {
                "type": "string"
              },
              "deprecationApproved": {
                "type": "boolean"
              },
              "deprecationApplied": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "public-entry"
                }
              }
            },
            "then": {
              "properties": {
                "publicClass": {
                  "enum": [
                    "project",
                    "research",
                    "service"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verificationState": {
                  "const": "needs-decision"
                }
              }
            },
            "then": {
              "properties": {
                "pendingDecisions": {
                  "type": "array",
                  "minItems": 1
                }
              },
              "required": [
                "pendingDecisions"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "deletedAt": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "deletedAt"
              ]
            },
            "then": {
              "properties": {
                "finalCommit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "repositoryUrl": {
                  "type": "null"
                }
              },
              "required": [
                "finalCommit"
              ]
            }
          }
        ]
      }
    }
  }
}
