{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/sponsorship.schema.json",
  "title": "Elixpo sponsorship policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lastVerified",
    "statusOwner",
    "policyStatus",
    "organizationAcceptsFunds",
    "organizationRoutesFunds",
    "publicSolicitationEnabled",
    "legalRecipient",
    "accountingProcess",
    "statement",
    "projectOwnedFunding",
    "independence",
    "stickers",
    "futureReview"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "lastVerified": {"type": "string", "format": "date"},
    "statusOwner": {"type": "string", "minLength": 2},
    "policyStatus": {"const": "not-accepting"},
    "organizationAcceptsFunds": {"const": false},
    "organizationRoutesFunds": {"const": false},
    "publicSolicitationEnabled": {"const": false},
    "legalRecipient": {"type": "null"},
    "accountingProcess": {"type": "null"},
    "statement": {"type": "string", "minLength": 20},
    "projectOwnedFunding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "statement"],
      "properties": {
        "allowed": {"const": true},
        "statement": {"type": "string", "minLength": 20}
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "research", "credit", "editorial"],
      "properties": {
        "selection": {"type": "string", "minLength": 20},
        "research": {"type": "string", "minLength": 20},
        "credit": {"type": "string", "minLength": 20},
        "editorial": {"type": "string", "minLength": 20}
      }
    },
    "stickers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sponsorshipRequestAllowed", "statement", "eventPartnerships"],
      "properties": {
        "sponsorshipRequestAllowed": {"const": true},
        "statement": {"type": "string", "minLength": 20},
        "eventPartnerships": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "monetary", "upTo100", "over100", "around200OrMore", "requestRequirements"],
          "properties": {
            "enabled": {"const": true},
            "monetary": {"const": false},
            "upTo100": {"type": "string", "minLength": 20},
            "over100": {"type": "string", "minLength": 20},
            "around200OrMore": {"type": "string", "minLength": 20},
            "requestRequirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}}
          }
        }
      }
    },
    "futureReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBeforeAcceptance", "requirements"],
      "properties": {
        "requiredBeforeAcceptance": {"const": true},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
