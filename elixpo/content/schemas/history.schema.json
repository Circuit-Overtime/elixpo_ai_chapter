{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/history.schema.json",
  "title": "Elixpo institutional history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "title", "description", "kind", "evidence"],
        "properties": {
          "period": { "type": "string", "minLength": 4 },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 50 },
          "kind": { "enum": ["origin", "growth", "systems", "direction", "release", "stewardship", "future"] },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
        }
      }
    }
  }
}
