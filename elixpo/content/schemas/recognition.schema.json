{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/recognition.schema.json",
  "title": "Elixpo contribution appreciation records",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "lastVerified", "issuer", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "issuer": { "type": "string", "minLength": 10 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "handle", "issuedAt", "period", "statement", "recordUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^ELX-APP-[0-9]{4}-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 3 },
          "handle": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
          "issuedAt": { "type": "string", "format": "date" },
          "period": { "type": "string", "minLength": 4 },
          "statement": { "type": "string", "minLength": 40 },
          "recordUrl": {
            "type": "string",
            "anyOf": [
              { "format": "uri" },
              { "pattern": "^/[a-z0-9][a-z0-9/_-]*$" }
            ]
          }
        }
      }
    }
  }
}
