{
  "name": "@elixpo/accounts",
  "version": "1.0.5",
  "description": "Standards-first OAuth and OpenID Connect SDK for Elixpo Accounts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elixpo/accounts.elixpo.git",
    "directory": "packages/accounts"
  },
  "homepage": "https://accounts.elixpo.com/docs/lixaccounts",
  "bugs": "https://github.com/elixpo/accounts.elixpo/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
