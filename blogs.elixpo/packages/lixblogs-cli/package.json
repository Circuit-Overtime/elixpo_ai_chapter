{
  "name": "@elixpo/lixblogs-cli",
  "version": "1.8.0",
  "description": "Official CLI for LixBlogs — publish, manage, and inspect blogs through the supported API. Built for creators and agent automation.",
  "author": {
    "name": "Elixpo",
    "email": "hello@elixpo.com",
    "url": "https://elixpo.com"
  },
  "contributors": [
    {
      "name": "Ayushman Bhattacharya",
      "url": "https://github.com/Circuit-Overtime"
    }
  ],
  "type": "module",
  "bin": {
    "lixblogs": "dist/lixblogs.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild bin/lixblogs.mjs --bundle --platform=node --format=esm --target=node18 --minify --tree-shaking=true --legal-comments=none --external:@napi-rs/keyring --outfile=dist/lixblogs.mjs",
    "test": "node --test tests/*.test.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "prepack": "npm run skills:sync && npm run build && npm test",
    "postpack": "node scripts/sync-skills.mjs --clean",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "keywords": [
    "lixblogs",
    "elixpo",
    "blog",
    "blogging",
    "markdown",
    "cli",
    "publishing",
    "cms",
    "creator-tools",
    "content-management",
    "oauth2",
    "device-flow",
    "automation",
    "terminal"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elixpo/blogs.elixpo.git",
    "directory": "packages/lixblogs-cli"
  },
  "homepage": "https://blogs.elixpo.com",
  "bugs": {
    "url": "https://github.com/elixpo/blogs.elixpo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.27.3"
  }
}
