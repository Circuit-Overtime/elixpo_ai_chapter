# GitHub renders this file on the repo's right-hand sidebar as a
# "Cite this repository" widget. Citation format: CFF v1.2.0.
#
# Update this file when:
#   * a new author / maintainer joins                 -> add to authors
#   * a new public version is released                -> bump `version` + `date-released`
#   * the project's identity / URL changes            -> update `repository-code`
#
# Validate locally with: pip install cffconvert && cffconvert -i CITATION.cff -f bibtex

cff-version: 1.2.0
message: "If you use OreoOS, the Oreo Badge, or the RV565 media pipeline, please cite this software."
title: "OreoOS: The Oreo Badge Operating System and RV565 Media Pipeline"
type: software
abstract: >
  OreoOS is a MicroPython-based application operating system for an
  ESP32-S3 conference badge. The repository includes the operating system,
  hardware drivers, host media-ingestion tools, and RV565, a frame-independent
  compressed RGB565 playback pipeline with native scaling and DMA experiments.
authors:
