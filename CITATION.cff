    given-names: Ayushman
    email: ayushman.elixpo@gmail.com
    affiliation: Pollinations AI
  - family-names: Chakraborty
    given-names: Anwesha
    email: anwesha.elixpo@gmail.com
    affiliation: "Department of Computer Science and Engineering, JIS University"
keywords:
  - conference-badge
  - micropython
  - esp32
  - esp32-s3
  - embedded
  - ota
  - hardware
  - oreoos
  - rgb565
  - video-playback
  - direct-memory-access
license: MIT
license-url: "https://github.com/elixpo/oreo/blob/main/LICENSE"
doi: "10.5281/zenodo.23543367"
identifiers:
