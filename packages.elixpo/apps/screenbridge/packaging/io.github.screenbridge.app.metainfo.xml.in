<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.screenbridge.app</id>
  <name>ScreenBridge</name>
  <summary>Share computer audio in one click</summary>
  <developer id="io.github.elixpo">
    <name>ScreenBridge contributors</name>
  </developer>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>ScreenBridge makes computer sound available to calls, recordings, and streams while keeping your microphone under your control.</p>
  </description>
  <launchable type="desktop-id">io.github.screenbridge.app.desktop</launchable>
  <icon type="stock">io.github.screenbridge.app</icon>
  <categories>
    <category>AudioVideo</category>
  </categories>
  <url type="homepage">https://github.com/elixpo/packages.elixpo/tree/main/apps/screenbridge</url>
  <provides>
    <binary>screenbridge</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="2026-10-09">
      <description>
        <p>First stable release, codenamed Aurora.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
